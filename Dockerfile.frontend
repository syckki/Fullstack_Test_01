# ==============================
# Stage 1: Build (Node 22.21.1 + Yarn 4)
# ==============================
FROM node:22.21.1-alpine AS builder

# Environment
ENV NODE_ENV=production

# Working directory
WORKDIR /app

# Environment variable passed at build time
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Copy dependency files
COPY package.json yarn.lock .yarnrc.yml ./

# Enable Corepack + Yarn 4
RUN corepack enable && corepack prepare yarn@4.11.0 --activate

# Install dependencies
RUN yarn install --immutable

# Copy application source code
COPY . .

# Build frontend (Vite output goes to /dist/public)
RUN yarn build

# ==============================
# Stage 2: Production (Nginx)
# ==============================
FROM nginx:alpine AS production

# Install wget (or replace with curl if needed)
RUN apk add --no-cache wget

# Copy built static files
COPY --from=builder /app/dist/public /usr/share/nginx/html

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Expose application port
EXPOSE 80

# Healthcheck (ensure /health exists or replace with /)
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

# Nginx startup command
CMD ["nginx", "-g", "daemon off;"]
