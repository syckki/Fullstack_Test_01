# ==============================
# Base: Node 22.21.1 + Yarn 4
# ==============================
FROM node:22.21.1-alpine AS production

# Entorno
ENV NODE_ENV=production

RUN apk add --no-cache curl

# Directorio de trabajo
WORKDIR /app

# Copiamos archivos de dependencias
COPY package.json yarn.lock .yarnrc.yml ./

# Habilitamos Corepack + Yarn 4
RUN corepack enable && corepack prepare yarn@4.11.0 --activate

# Instalamos dependencias (usa node_modules, por .yarnrc.yml)
RUN yarn install --immutable

# Copiamos el resto del código
COPY . .

# Construimos la app (frontend + backend según tu script "build")
RUN yarn build

# Exponemos puerto del backend
EXPOSE 3000

# (Opcional) Cambia luego /health por un endpoint sin auth
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1); });"

# Comando de arranque
# (En tu package.json: "start": "NODE_ENV=production node dist/index.js")
CMD ["yarn", "start"]
